{
  "version": "1.0",
  "description": "WorkBuddy Hooks System 配置",
  
  "hooks": [
    {
      "id": "session_end_memory",
      "type": "session_end",
      "enabled": true,
      "name": "会话结束自动记忆",
      "description": "会话结束时自动提取高价值信息并更新记忆",
      "condition": "complexity > 3",
      "actions": [
        {
          "type": "execute",
          "command": "python",
          "args": ["-c", "print('更新记忆')"],
          "timeout": 30
        }
      ]
    },
    
    {
      "id": "session_end_sync",
      "type": "session_end",
      "enabled": true,
      "name": "同步到 Obsidian",
      "description": "会话结束时同步记忆到 Obsidian",
      "condition": "hasChanges == true",
      "actions": [
        {
          "type": "sync",
          "target": "obsidian",
          "direction": "push"
        }
      ]
    },
    
    {
      "id": "tool_error_recovery",
      "type": "tool_error",
      "enabled": true,
      "name": "工具错误自动恢复",
      "description": "工具执行失败时尝试自动恢复",
      "condition": "exitCode != 0",
      "actions": [
        {
          "type": "log",
          "level": "error",
          "message": "工具 {{tool_name}} 执行失败: {{error}}"
        },
        {
          "type": "notify",
          "channel": "console",
          "message": "⚠️ 工具执行失败，建议检查命令"
        }
      ]
    },
    
    {
      "id": "task_complete_reflection",
      "type": "task_complete",
      "enabled": true,
      "name": "任务完成五维反思",
      "description": "复杂任务完成后进行五维反思并更新置信度",
      "condition": "complexity > 5",
      "actions": [
        {
          "type": "log",
          "level": "info",
          "message": "任务 {{task_id}} 完成，进行五维反思"
        }
      ]
    },
    
    {
      "id": "context_auto_compress",
      "type": "turn_end",
      "enabled": true,
      "name": "上下文自动压缩",
      "description": "上下文使用率超过 80% 时自动压缩",
      "condition": "context_usage > 0.8",
      "actions": [
        {
          "type": "compress",
          "target_ratio": 0.3,
          "preserve_system": true
        }
      ]
    },
    
    {
      "id": "pre_tool_safety",
      "type": "pre_tool_use",
      "enabled": true,
      "name": "工具执行前安全检查",
      "description": "执行危险命令前记录日志",
      "condition": "isDangerous == true",
      "actions": [
        {
          "type": "log",
          "level": "warn",
          "message": "⚠️ 即将执行危险命令: {{tool_name}}"
        }
      ]
    },
    
    {
      "id": "post_tool_success",
      "type": "post_tool_use",
      "enabled": false,
      "name": "工具成功执行日志",
      "description": "记录工具成功执行",
      "condition": "exitCode == 0",
      "actions": [
        {
          "type": "log",
          "level": "info",
          "message": "✓ {{tool_name}} 执行成功"
        }
      ]
    },
    
    {
      "id": "turn_end_stats",
      "type": "turn_end",
      "enabled": false,
      "name": "轮次统计",
      "description": "记录每轮对话统计",
      "condition": null,
      "actions": [
        {
          "type": "log",
          "level": "info",
          "message": "轮次统计: tokens={{tokens}}, time={{duration}}ms"
        }
      ]
    },
    
    {
      "id": "session_start_welcome",
      "type": "session_start",
      "enabled": false,
      "name": "会话开始欢迎",
      "description": "会话开始时显示欢迎信息",
      "condition": null,
      "actions": [
        {
          "type": "notify",
          "channel": "console",
          "message": "👋 会话开始，当前上下文使用: {{context_usage}}%"
        }
      ]
    },
    
    {
      "id": "user_message_pattern",
      "type": "user_message",
      "enabled": false,
      "name": "用户消息模式识别",
      "description": "识别用户消息中的模式",
      "condition": "containsKeyword == true",
      "actions": [
        {
          "type": "log",
          "level": "info",
          "message": "识别到关键词: {{keyword}}"
        }
      ]
    },
    
    {
      "id": "guardian_pre_tool_check",
      "type": "pre_tool_use",
      "enabled": true,
      "name": "[P4-4] 运行时安全扫描",
      "description": "工具执行前通过 RuntimeGuardian 进行安全扫描",
      "condition": "tool_name == Bash || tool_name == PowerShell || tool_name == Write",
      "actions": [
        {
          "type": "execute",
          "command": "node",
          "args": ["-e", "const RG=require('~/.workbuddy/plugins/runtime-guardian/index.js');const rg=new RG();const r=rg.checkCommand(process.argv[1]);if(!r.safe){console.log(JSON.stringify(r));process.exit(1)}", "{{args}}"],
          "timeout": 10
        }
      ]
    },
    
    {
      "id": "orch_task_decompose",
      "type": "task_start",
      "enabled": true,
      "name": "[P4-1] 复杂任务自动分解",
      "description": "复杂度≥6的任务自动通过 TaskOrchestrator 分解",
      "condition": "complexity >= 6",
      "actions": [
        {
          "type": "log",
          "level": "info",
          "message": "[TaskOrchestrator] 检测到复杂任务 (复杂度={{complexity}})，触发任务分解"
        },
        {
          "type": "execute",
          "command": "node",
          "args": ["-e", "const TO=require('~/.workbuddy/plugins/task-orchestrator/index.js');const to=new TO();const r=to.decomposeGoal('{{task_description}}');console.log(JSON.stringify({tasks:r.tasks.length,complexity:r.complexity,deps:r.graph.length}))"],
          "timeout": 15
        }
      ]
    },
    
    {
      "id": "eval_regression_check",
      "type": "task_complete",
      "enabled": true,
      "name": "[P4-2] 评测回归检测",
      "description": "复杂任务完成后运行 EvalFramework 回归检测",
      "condition": "complexity >= 7",
      "actions": [
        {
          "type": "log",
          "level": "info",
          "message": "[EvalFramework] 复杂任务完成，触发回归检测"
        },
        {
          "type": "execute",
          "command": "node",
          "args": ["-e", "const EF=require('~/.workbuddy/plugins/eval-framework/index.js');const ef=new EF();const baseline=ef.getBaseline('current');console.log(baseline?'回归检测完成':'无基线数据-跳过')"],
          "timeout": 15
        }
      ]
    },
    
    {
      "id": "mao_auto_route",
      "type": "task_start",
      "enabled": false,
      "name": "[P4-3] 多Agent自动路由",
      "description": "极高复杂度任务(≥8)启用多Agent协作",
      "condition": "complexity >= 8",
      "actions": [
        {
          "type": "log",
          "level": "info",
          "message": "[MultiAgentOrchestrator] 极高复杂度任务，建议启用多Agent协作"
        },
        {
          "type": "notify",
          "channel": "console",
          "message": "🤖 检测到极高复杂度任务 ({{complexity}}/10)，建议使用多Agent团队协作"
        }
      ]
    },
    
    {
      "id": "context_scan_on_start",
      "type": "session_start",
      "enabled": true,
      "name": "[P4-5] 会话开始上下文扫描",
      "description": "会话开始时运行 ContextAwareness 扫描环境/项目/时间",
      "actions": [
        {
          "type": "execute",
          "command": "node",
          "args": ["-e", "const CA=require('~/.workbuddy/plugins/context-awareness/index.js');const ca=new CA();const ctx=ca.scanAll();console.log(JSON.stringify({project:ctx.project.name,type:ctx.project.type,time:ctx.time.timeOfDay,os:ctx.environment.os}))"],
          "timeout": 10
        },
        {
          "type": "log",
          "level": "info",
          "message": "[ContextAwareness] 上下文已扫描: {{context_summary}}"
        }
      ]
    },
    
    {
      "id": "decay_compress_on_overload",
      "type": "turn_end",
      "enabled": true,
      "name": "[P4-6] 记忆衰减压缩",
      "description": "长会话(>15轮)时触发 MemoryDecay 上下文压缩",
      "condition": "turn_count >= 15 && (turn_count % 5 == 0)",
      "actions": [
        {
          "type": "execute",
          "command": "node",
          "args": ["-e", "const MD=require('~/.workbuddy/plugins/memory-decay/index.js');const md=new MD();const stats=md.getDecayStats();const health=md.getMemoryHealthScore();console.log(JSON.stringify({stats,health}))"],
          "timeout": 10
        },
        {
          "type": "compress",
          "target_ratio": 0.4,
          "preserve_system": true
        }
      ]
    },
    
    {
      "id": "fusion_sync_on_end",
      "type": "session_end",
      "enabled": true,
      "name": "[P4-7] 会话结束融合同步",
      "description": "会话结束时触发 FusionSyncEnhancer 增量同步到 HERMES",
      "condition": "hasChanges == true",
      "actions": [
        {
          "type": "execute",
          "command": "node",
          "args": ["-e", "const FSE=require('~/.workbuddy/plugins/fusion-sync-enhancer/index.js');const fse=new FSE();const r=fse.incrementalSync('wb→hm',{dryRun:false});console.log('Sync:',r.summary.totalOps,'ops,',r.summary.conflicts,'conflicts')"],
          "timeout": 30
        },
        {
          "type": "log",
          "level": "info",
          "message": "[FusionSyncEnhancer] 同步完成: {{sync_summary}}"
        }
      ]
    },
    
    {
      "id": "eval_runtime_auto",
      "type": "session_start",
      "enabled": true,
      "name": "[P4-2] 运行时评测追踪",
      "description": "会话开始时自动启动 EvalFramework 运行时追踪",
      "actions": [
        {
          "type": "execute",
          "command": "node",
          "args": ["-e", "const EF=require('~/.workbuddy/plugins/eval-framework/index.js');const ef=new EF();ef.startTracking('{{session_id}}');console.log('[Eval] Tracking:', '{{session_id}}')"],
          "timeout": 5
        }
      ]
    },
    
    {
      "id": "eval_runtime_end",
      "type": "session_end",
      "enabled": true,
      "name": "[P4-2] 会话结束评测汇总",
      "description": "会话结束时汇总运行时评测数据",
      "actions": [
        {
          "type": "execute",
          "command": "node",
          "args": ["-e", "const EF=require('~/.workbuddy/plugins/eval-framework/index.js');const ef=new EF();const m=ef.endTracking('{{session_id}}');if(m)console.log(JSON.stringify({overall:m.overallScore,completion:m.taskCompletionRate,safety:m.safetyScore}))"],
          "timeout": 10
        }
      ]
    },
    
    {
      "id": "learning_loop_cycle",
      "type": "session_end",
      "enabled": true,
      "name": "[P4-8] 学习闭环周期",
      "description": "会话结束时运行 LearningLoop 分析→提取→强化周期",
      "condition": "complexity >= 4",
      "actions": [
        {
          "type": "execute",
          "command": "node",
          "args": ["-e", "const LL=require('~/.workbuddy/plugins/learning-loop/index.js');const l=new LL();const r=l.runLearningCycle({id:'{{session_id}}',taskType:'{{task_type}}',complexity:{{complexity}},toolCalls:{{tool_calls}},success:{{success}},duration:{{duration}}});console.log('[Learn] Cycle',r.cycle,':',r.instinctsExtracted,'instincts,',r.totalInstincts,'total')"],
          "timeout": 15
        }
      ]
    },
    
    {
      "id": "orch_priority_schedule",
      "type": "task_start",
      "enabled": true,
      "name": "[P4-1] 优先级调度",
      "description": "复杂任务自动进入优先级队列调度",
      "condition": "complexity >= 5",
      "actions": [
        {
          "type": "execute",
          "command": "node",
          "args": ["-e", "const TO=require('~/.workbuddy/plugins/task-orchestrator/index.js');const to=new TO();const r=to.scheduleWithPriority('{{task_id}}',{{complexity}});console.log('[Sched] Queued:',r.taskId,'pri=',r.priority,'q=',r.queueLength)"],
          "timeout": 5
        }
      ]
    },
    
    {
      "id": "fusion_route_task",
      "type": "task_start",
      "enabled": true,
      "name": "[P4-9] 融合智能路由",
      "description": "任务启动时 FusionRouter 分析最佳执行系统(WB/HERMES/协作)",
      "actions": [
        {
          "type": "execute",
          "command": "node",
          "args": ["-e", "const FR=require('~/.workbuddy/plugins/fusion-router/index.js');const fr=new FR();const r=fr.route({description:'{{task_description}}'});console.log(JSON.stringify({route:r.winner,confidence:r.confidence,rec:r.recommendation}))"],
          "timeout": 10
        },
        {
          "type": "log",
          "level": "info",
          "message": "[FusionRouter] → {{route}} ({{confidence}}%)"
        }
      ]
    }
  ],
  
  "_metadata": {
    "created": "2026-05-11",
    "updated": "2026-05-12",
    "author": "WorkBuddy AI Engineer",
    "version": "2.3",
    "changes": "新增 P4-9 融合智能路由 Hook"
  }
}
