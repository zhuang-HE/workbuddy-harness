{
  "version": "2.0",
  "description": "WorkBuddy Hooks System v2.0 - Engine-enabled actions",
  
  "hooks": [
    {
      "id": "session_end_memory",
      "type": "session_end",
      "enabled": true,
      "name": "会话结束自动记忆",
      "description": "会话结束时自动提取高价值信息并更新记忆",
      "condition": "complexity > 3",
      "actions": [
        { "type": "harness", "plugin": "memory-decay", "method": "registerMemory", "args": [{ "content": "{{task_description}}", "type": "task_state", "importance": 3 }] }
      ]
    },
    {
      "id": "session_end_sync",
      "type": "session_end",
      "enabled": true,
      "name": "同步到 Obsidian",
      "description": "会话结束时同步记忆到 Obsidian",
      "condition": "hasChanges == true",
      "actions": [
        { "type": "sync", "target": "obsidian", "direction": "push" }
      ]
    },
    {
      "id": "tool_error_recovery",
      "type": "tool_error",
      "enabled": true,
      "name": "工具错误自动恢复",
      "description": "工具执行失败时尝试自动恢复",
      "condition": "exitCode != 0",
      "actions": [
        { "type": "log", "level": "error", "message": "Tool {{tool_name}} failed: {{error}}" },
        { "type": "notify", "channel": "console", "message": "Tool error: {{tool_name}}" }
      ]
    },
    {
      "id": "task_complete_reflection",
      "type": "task_complete",
      "enabled": true,
      "name": "任务完成反思",
      "description": "复杂任务完成后进行反思",
      "condition": "complexity > 5",
      "actions": [
        { "type": "log", "level": "info", "message": "Task {{task_id}} completed" }
      ]
    },
    {
      "id": "context_auto_compress",
      "type": "turn_end",
      "enabled": true,
      "name": "上下文自动压缩",
      "description": "上下文使用率超过 80% 时自动压缩",
      "condition": "context_usage > 0.8",
      "actions": [
        { "type": "compress", "target_ratio": 0.3, "preserve_system": true }
      ]
    },
    {
      "id": "pre_tool_safety",
      "type": "pre_tool_use",
      "enabled": true,
      "name": "工具执行前安全检查",
      "description": "执行危险命令前安全检查",
      "condition": "isDangerous == true",
      "actions": [
        { "type": "harness", "plugin": "runtime-guardian", "method": "scanCommand", "args": ["{{args}}"] }
      ]
    },
    {
      "id": "guardian_pre_tool_check",
      "type": "pre_tool_use",
      "enabled": true,
      "name": "运行时安全扫描 (v2.0)",
      "description": "工具执行前通过 RuntimeGuardian v2.0 进行安全扫描",
      "condition": "tool_name == Bash || tool_name == PowerShell || tool_name == Write",
      "actions": [
        { "type": "harness", "plugin": "runtime-guardian", "method": "preToolCheck", "args": ["{{tool_name}}", "{{args}}"] }
      ]
    },
    {
      "id": "orch_task_decompose",
      "type": "task_start",
      "enabled": true,
      "name": "复杂任务自动分解",
      "description": "复杂度>=6的任务自动分解",
      "condition": "complexity >= 6",
      "actions": [
        { "type": "harness", "plugin": "task-orchestrator", "method": "decomposeGoal", "args": ["{{task_description}}"] }
      ]
    },
    {
      "id": "eval_regression_check",
      "type": "task_complete",
      "enabled": true,
      "name": "评测回归检测",
      "description": "复杂任务完成后运行回归检测",
      "condition": "complexity >= 7",
      "actions": [
        { "type": "harness", "plugin": "eval-framework", "method": "startTracking", "args": ["{{session_id}}"] }
      ]
    },
    {
      "id": "mao_auto_route",
      "type": "task_start",
      "enabled": true,
      "name": "多Agent智能路由",
      "description": "按复杂度自动选择协作模式",
      "condition": "complexity >= 4",
      "actions": [
        { "type": "harness", "plugin": "multi-agent-orchestrator", "method": "startOrchestration", "args": ["{{task_description}}"] }
      ]
    },
    {
      "id": "context_scan_on_start",
      "type": "session_start",
      "enabled": true,
      "name": "会话开始上下文扫描",
      "description": "会话开始时扫描环境/项目/时间",
      "actions": [
        { "type": "harness", "plugin": "context-awareness", "method": "scanAll" }
      ]
    },
    {
      "id": "decay_compress_on_overload",
      "type": "turn_end",
      "enabled": true,
      "name": "记忆衰减压缩",
      "description": "长会话(>15轮)时触发记忆压缩",
      "condition": "turn_count >= 15 && (turn_count % 5 == 0)",
      "actions": [
        { "type": "harness", "plugin": "memory-decay", "method": "getDecayStats" },
        { "type": "compress", "target_ratio": 0.4, "preserve_system": true }
      ]
    },
    {
      "id": "fusion_sync_on_end",
      "type": "session_end",
      "enabled": true,
      "name": "会话结束融合同步",
      "description": "会话结束时增量同步",
      "condition": "hasChanges == true",
      "actions": [
        { "type": "harness", "plugin": "fusion-sync-enhancer", "method": "incrementalSync", "args": ["wb_to_hm", { "dryRun": false }] }
      ]
    },
    {
      "id": "eval_runtime_auto",
      "type": "session_start",
      "enabled": true,
      "name": "运行时评测追踪 (v2.0)",
      "description": "会话开始时自动启动评测追踪",
      "actions": [
        { "type": "harness", "plugin": "eval-framework", "method": "startTracking", "args": ["{{session_id}}"] }
      ]
    },
    {
      "id": "eval_runtime_end",
      "type": "session_end",
      "enabled": true,
      "name": "会话结束评测汇总 (v2.0)",
      "description": "会话结束时汇总运行时评测数据",
      "actions": [
        { "type": "harness", "plugin": "eval-framework", "method": "endTracking", "args": ["{{session_id}}"] }
      ]
    },
    {
      "id": "learning_loop_cycle",
      "type": "session_end",
      "enabled": true,
      "name": "学习闭环周期",
      "description": "会话结束时运行学习周期",
      "condition": "complexity >= 4",
      "actions": [
        { "type": "harness", "plugin": "learning-loop", "method": "runLearningCycle", "args": [{ "id": "{{session_id}}", "taskType": "{{task_type}}", "complexity": "{{complexity}}", "success": "{{success}}" }] }
      ]
    },
    {
      "id": "fusion_route_task",
      "type": "task_start",
      "enabled": true,
      "name": "融合智能路由",
      "description": "任务启动时分析最佳执行系统",
      "actions": [
        { "type": "harness", "plugin": "fusion-router", "method": "route", "args": [{ "description": "{{task_description}}" }] }
      ]
    }
  ],
  
  "_metadata": {
    "created": "2026-05-11",
    "updated": "2026-05-17",
    "author": "WorkBuddy Harness v2.0",
    "version": "2.0",
    "changes": "v2.0: Replace node -e require(...) patterns with harness action type. All hooks use HookRunner engine for execution."
  }
}
